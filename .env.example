# Copia a .env.local para desarrollo con «vercel dev».
# En producción, define estas variables en Vercel → Project → Settings → Environment Variables.
# Nunca subas .env con secretos reales al repositorio.

# Usuario y contraseña del panel /admin.html (solo servidor; no van al navegador)
ADMIN_USERNAME=Judit
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar la sesión (obligatorio: mínimo 16 caracteres)
AUTH_SECRET=genera-un-secreto-largo-y-único

# Vercel Blob: Storage → crea un store y copia el token «Read and Write»
BLOB_READ_WRITE_TOKEN=
